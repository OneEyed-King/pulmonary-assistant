        "section": [
          {
            "title": "Subjective",
            "text": {
              "status": "generated",
              "div": "<div xmlns='http://www.w3.org/1999/xhtml'>Patient reports occasional gum bleeding when brushing. Overdue for periodontal maintenance (last seen 8 months ago, recall interval is 3-4 months given periodontitis history).</div>"
            }
          },
          {
            "title": "Objective",
            "text": {
              "status": "generated",
              "div": "<div xmlns='http://www.w3.org/1999/xhtml'>Average pocket depth 5mm, 34% bleeding on probing. Generalized moderate chronic periodontitis, localized recession. FMX shows 20-30% horizontal bone loss posterior sextants.</div>"
            }
          },
          {
            "title": "Assessment",
            "text": {
              "status": "generated",
              "div": "<div xmlns='http://www.w3.org/1999/xhtml'>Chronic periodontitis, Stage II Grade B, currently under-maintained.</div>"
            }
          },
          {
            "title": "Plan",
            "text": {
              "status": "generated",
              "div": "<div xmlns='http://www.w3.org/1999/xhtml'>Scaling and root planing performed posterior quadrants. Reinforced oral hygiene instruction. Recall in 3-4 months \u2014 critical given periodontitis history.</div>"
            }
          }
        ]
      },
